# ============================================================
# 절대 커밋 금지 — 개인정보·자격증명
# ============================================================
# 원본 덤프는 정규화 결과보다 민감하다. 필드를 안 버렸으므로
# 태그 값의 담당자 이메일·전화번호가 그대로 들어 있을 수 있다.
# 개인정보 관리 도구가 스스로 개인정보 파일을 만드는 상황을 피한다.
snapshots/
output/

# 자격증명 — 실계정 키가 저장소에 들어가면 즉시 사고다
.env
.env.*
!.env.example
*.credentials
credentials
.aws/
*.pem
*.key
*.p12
*.pfx

# ============================================================
# 작업 메모 — 저장소에 올리지 않는다
# ============================================================
# 작업 규칙·확정 사항의 로컬 기록. 공개 문서는 README.md와 docs/ 가 담당한다.
CLAUDE.md

# ============================================================
# 개발 환경
# ============================================================
.venv/
venv/
env/
.python-version

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# 편집기 · OS
# ============================================================
.idea/
.vscode/
*.swp
*~

.DS_Store
._*
Thumbs.db

# Excel 임시 파일 (수기 템플릿을 열어두면 생긴다)
~$*.xlsx

# 담당 B — 사람이 채운 수기 값. 작성자 이름이 들어가므로 커밋하지 않는다
state/
